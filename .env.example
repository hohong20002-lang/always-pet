# MongoDB Atlas > Database > Connect > Drivers 에서 복사한 연결 주소 (<password>를 실제 비밀번호로 바꾸기)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=always_pet

# 관리자 화면(/admin)을 쓸 수 있는 회원 이메일 (여러 명이면 쉼표로 구분)
ADMIN_EMAILS=

# 토스페이먼츠 테스트 키 (공식 문서 공개 테스트 키 — 실제 돈이 나가지 않아요)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
